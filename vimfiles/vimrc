" Fix "goto file" (gf) in some projects
if has("autocmd")
  fun! IncludeExpr_ts_babel()
    " see './tsconfig.json' -> 'compilerOptions' -> 'paths'
    " see './babel.config.js' & './jest.config.js'
    if v:fname =~? '^@config\/'
      return substitute(v:fname, '^@config\/', './src/config/', 'g')
    elseif v:fname =~? '^@core\/'
      return substitute(v:fname, '^@core\/', './src/core/', 'g')
    elseif v:fname =~? '^@features\/'
      return substitute(v:fname, '^@features\/', './src/features/', 'g')
    elseif v:fname =~? '^@shared\/'
      return substitute(v:fname, '^@shared\/', './src/shared/', 'g')
    elseif v:fname =~? '^@store\/'
      return substitute(v:fname, '^@store\/', './src/store/', 'g')
    elseif v:fname =~? '^@utils\/'
      return substitute(v:fname, '^@utils\/', './src/utils/', 'g')
    elseif v:fname =~? '^@test\/'
      return substitute(v:fname, '^@test\/', './test/', 'g')
    endif
    return v:fname
  endfun
  autocmd FileType javascript,javascriptreact,typescript,typescriptreact
    \ if expand('%:p') =~? 'funeral-erp-core-ui'
    \ | setlocal includeexpr=IncludeExpr_ts_babel()
    \ | endif

  fun! IncludeExpr_Java(prj)
    let attempted = v:fname
    if filereadable(attempted)
      return attempted
    endif
    " `Type.MEMBER` / `Outer.Inner` -> `Type` / `Outer`; leave `pkg.Type` as-is
    let type_name = v:fname =~# '^\u' ? matchstr(v:fname, '^\w\+') : v:fname
    let pattern = '^import\s\+\(\%\(\w\+\.\)*' . escape(type_name, '.') . '\)\s*;$'
    let match = search(pattern, 'zncbW')
    if match > 0
      let matches = matchlist(getline(match), pattern)
      if len(matches) > 1
        let filepath = substitute(matches[1], '\.', '/', 'g') . '.java'
        if a:prj == 'some-java-project-name'
          let attempted = './src/main/java/' . filepath
        elseif a:prj == 'legacy'
          let attempted = './src/' . filepath
        elseif a:prj == 'next'
          let attempted = './src/main/java/' . filepath
        else
          let attempted = './' . filepath
        endif
      else
        " no import -> maybe same package
        let attempted = expand('%:h') . '/' . type_name . '.java'
      endif
    else
      " no import -> maybe same package
      let attempted = expand('%:h') . '/' . type_name . '.java'
    endif
    if filereadable(attempted)
      return attempted
    endif
    return v:fname
  endfun
  autocmd FileType java
    \ if expand('%:p') =~? 'some-java-project'
    \ | let prj='some-java-project-name'
    \ | elseif expand('%:p') =~? 'funeral-erp-core-api'
    \ | let prj='next'
    \ | elseif expand('%:p') =~? 'funeral-erp-legacy-api'
    \ | let prj='legacy'
    \ | else
    \ | let prj=''
    \ | endif
    \ | let &l:includeexpr= 'IncludeExpr_Java(' . string(prj) . ')'
endif " has("autocmd")

